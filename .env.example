# Copy to .env for local development. Never commit real secrets.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://sentinel:sentinel_dev_only@localhost:5432/sentinel
MAX_UPLOAD_MB=25

# Comma-separated frontend origins allowed to call the API.
SENTINEL_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set in the frontend environment when the API is hosted remotely.
# NEXT_PUBLIC_SENTINEL_API_URL=https://your-api-host.example

# SQLite path for derived analysis summaries; mount a persistent volume here in production.
SENTINEL_DB_PATH=data/sentinel.db
